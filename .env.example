# The secret that must appear as ?key=<value> on the URL once to grant access.
# e.g. share https://your-app.vercel.app/?key=something-long-and-random with James and Emma.
ACCESS_KEY=

# https://www.behindthename.com/api/ — used to pull random name suggestions and
# look up which languages a name is used in.
BEHIND_THE_NAME_API_KEY=

# Postgres connection string. In Vercel this is injected automatically by the
# "Postgres" (Neon) storage integration. Locally, point this at a Neon "dev"
# branch connection string (Neon dashboard → your project → Branches → dev).
DATABASE_URL=
